<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ExportOptions.plist — what `xcodebuild -exportArchive` needs to turn
     Pippin.xcarchive into a Pippin.ipa for installing on your own phone.
     ExportOptions-AppStore.plist beside it is the App Store and TestFlight
     export; both read the same archive. See BUILDING.md, "Step 4".

     `debugging` is Xcode 15.3+'s name for what used to be spelled
     `development`: an app signed with a development identity, installable
     only on the devices already in the provisioning profile.

     `signingStyle` is automatic to match the targets, which are both
     CODE_SIGN_STYLE = Automatic; Xcode picks the profile it already made for
     `org.peregrine.Pippin` and `org.peregrine.Pippin.Share`. The extension
     needs its own, which is why the second one exists at all. The team those
     profiles come from is `PP_DEVELOPMENT_TEAM`, set in local/Local.xcconfig
     — see Pippin.xcconfig.

     A profile's life is a year under a paid Developer Program membership and
     one week under a free Apple ID, and an expired one is what
     IXUserPresentableErrorDomain error 14 means. BUILDING.md's "The profile
     clock" says how to read the date out of a bundle. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>debugging</string>
	<!-- No `teamID` key. It identifies a personal Apple account and this file
	     is public, so the team is left to be inferred from the archive's own
	     embedded provisioning profile — which under automatic signing is the
	     one Xcode already chose. An account that belongs to more than one team
	     has to say which: add the key back in a local copy of this file and
	     point `-exportOptionsPlist` at that. -->
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- One binary carrying every architecture, rather than a per-device
	     thinned variant: a sideloaded .ipa is installed by hand and there is
	     no App Store to pick the right slice. -->
	<key>thinning</key>
	<string>&lt;none&gt;</string>
	<!-- Nothing here is uploaded anywhere, so there is nobody to send
	     symbols to; the dSYMs stay in the .xcarchive where a crash log can
	     still be symbolicated against them. -->
	<key>uploadSymbols</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
