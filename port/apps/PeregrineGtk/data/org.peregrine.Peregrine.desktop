[Desktop Entry]
Type=Application
Name=Peregrine
GenericName=Map Viewer
Comment=View and annotate raster and vector map data
Exec=peregrine-gtk
Icon=org.peregrine.Peregrine
Terminal=false
Categories=Education;Science;Geography;GTK;
Keywords=map;chart;GIS;GeoTIFF;DTED;CADRG;OpenStreetMap;
StartupNotify=true
