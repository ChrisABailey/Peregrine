  <mime-type type="application/x-peregrine-package">
    <comment>Peregrine overlay package</comment>
    <sub-class-of type="application/zip"/>
    <generic-icon name="package-x-generic"/>
    <glob pattern="*.pgpkg"/>
  </mime-type>
</mime-info>
