    {
      "name": "cartographic",
      "title": "Cartographic objects and annotation",
      "enabled": false,
      "select": ["key=$AREAS", "key=$LINES", "key=$CSYMB", "key=$COMPS",
                 "key=$TEXTS", "key=ANNOTA", "key=NEWOBJ"]
    }
  ]
}
