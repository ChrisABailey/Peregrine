      "enabled": false,
      "select": ["key=M_ACCY", "key=M_COVR", "key=M_CSCL", "key=M_HDAT",
                 "key=M_HOPA", "key=M_NPUB", "key=M_NSYS", "key=M_PROD",
                 "key=M_QUAL", "key=M_SDAT", "key=M_SREL", "key=M_UNIT",
