# Sets FVW_SDK_BUILD_ID, the id a `native` plugin must match to load
# (port/extensions-plan.md §2b), and writes it to
# <build>/port/sdk/gen/peregrine/fv_sdk_build_id.h.
# It is computed at configure time from the Peregrine version, the git
# commit, the compiler, the C++ standard library and the platform; a commit
# made without reconfiguring keeps the previous id.
set(PEREGRINE_VERSION "0.0.0" CACHE STRING "Peregrine version")

execute_process(
  COMMAND git rev-parse --short=12 HEAD
  WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
  OUTPUT_VARIABLE _fvw_commit
  OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_QUIET
  RESULT_VARIABLE _fvw_git_rc)
if(NOT _fvw_git_rc EQUAL 0 OR _fvw_commit STREQUAL "")
  set(_fvw_commit "nogit")
endif()

if(MSVC)
  set(_fvw_stdlib msvcstl)
elseif(APPLE OR CMAKE_CXX_FLAGS MATCHES "-stdlib=libc\\+\\+")
  set(_fvw_stdlib libc++)
else()
  set(_fvw_stdlib libstdc++)
endif()

if(APPLE AND CMAKE_OSX_ARCHITECTURES)
  string(REPLACE ";" "+" _fvw_arch "${CMAKE_OSX_ARCHITECTURES}")
else()
  set(_fvw_arch ${CMAKE_SYSTEM_PROCESSOR})
endif()

set(FVW_SDK_BUILD_ID
  "${PEREGRINE_VERSION}/${_fvw_commit}/${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}/${_fvw_stdlib}/${CMAKE_SYSTEM_NAME}-${_fvw_arch}")
message(STATUS "fvw: native plugin build id ${FVW_SDK_BUILD_ID}")

set(FVW_SDK_GEN_DIR ${CMAKE_BINARY_DIR}/port/sdk/gen)
file(CONFIGURE OUTPUT ${FVW_SDK_GEN_DIR}/peregrine/fv_sdk_build_id.h CONTENT
"/// The build id of this Peregrine; generated by port/cmake/PeregrineBuildId.cmake.
#pragma once
#define FV_SDK_BUILD_ID \"@FVW_SDK_BUILD_ID@\"
" @ONLY)
