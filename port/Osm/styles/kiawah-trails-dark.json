{
  "version": 8,
  "name": "Kiawah Trails Dark",
  "id": "kiawah-trails-dark",
  "metadata": {
    "peregrine:note": "Kiawah Trails recoloured for a dark display: the same layers, filters and widths, with a dark brown-grey ground, dark blue water, dark green vegetation and dark brown sand. Not a night palette; every feature class stays. Generated by port/tools/make_dark_style.py; edit the palette there.",
    "peregrine:palette": "Land #30342c, water #33467a, marsh #2a3a2d, beach #54442e, course #26382a, fairway #31512f, green #447242, bunker #5e4b2e, bike #e2563d, walk #c98b64, boardwalk #a07d4f, building #26221d outlined #8a8a8a.",
    "peregrine:golf-paths": "Golf paths reach the tiles as class=path subclass=path with foot=designated and/or bicycle=no, and cart paths as paved or bicycle=no tracks. The profile now writes `golf` (path|cartpath) on those ways; the tag heuristics remain for tiles built before it did.",
    "peregrine:derived-from": "kiawah-trails.json"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector"
    }
  },
  "sprite": "symbols/kiawah-dark",
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#30342c"}},
    {"id": "wood", "type": "fill", "source-layer": "landcover", "filter": ["==", "class", "wood"], "paint": {"fill-color": "#243624"}},
    {"id": "golf-course", "type": "fill", "source-layer": "landcover", "minzoom": 10, "filter": ["==", "subclass", "golf_course"], "paint": {"fill-color": "#26382a", "fill-outline-color": "#34503a"}},
    {"id": "park", "type": "fill", "source-layer": "landcover", "filter": ["in", "subclass", "park", "recreation_ground", "garden"], "paint": {"fill-color": "#283b28"}},
    {"_comment": "On Kiawah nearly every landuse=grass polygon is a fairway, tee or rough, so plain grass takes the fairway green.", "id": "grass", "type": "fill", "source-layer": "landcover", "filter": ["all", ["==", "class", "grass"], ["==", "subclass", "grass"]], "paint": {"fill-color": "#2d482c", "fill-outline-color": {"stops": [[14, "#2d482c"], [16, "#3b5c37"]]}}},
    {"id": "farmland", "type": "fill", "source-layer": "landcover", "filter": ["==", "class", "farmland"], "paint": {"fill-color": "#433c31"}},
    {"id": "marsh", "type": "fill", "source-layer": "landcover", "filter": ["all", ["==", "class", "wetland"], ["!=", "subclass", "tidalflat"]], "paint": {"fill-color": "#2a3a2d"}},
    {"id": "tidalflat", "type": "fill", "source-layer": "landcover", "filter": ["==", "subclass", "tidalflat"], "paint": {"fill-color": "#3a3628"}},
    {"_comment": "fill-pattern cannot be zoom-gated, so the tuft texture is its own layer.", "id": "marsh-pattern", "type": "fill", "source-layer": "landcover", "minzoom": 16.5, "filter": ["all", ["==", "class", "wetland"], ["!=", "subclass", "tidalflat"]], "paint": {"fill-pattern": "marsh_pattern"}},
    {"id": "beach", "type": "fill", "source-layer": "landcover", "filter": ["==", "subclass", "beach"], "paint": {"fill-color": "#54442e"}},
    {"_comment": "natural=sand is almost all bunkers here; the edge is what makes a bunker read as one.", "id": "sand", "type": "fill", "source-layer": "landcover", "filter": ["==", "subclass", "sand"], "paint": {"fill-color": "#58462b", "fill-outline-color": {"stops": [[14, "#58462b"], [15, "#715a35"]]}}},
    {"id": "pitch", "type": "fill", "source-layer": "landuse", "minzoom": 14, "filter": ["==", "class", "pitch"], "paint": {"fill-color": "#2f472e", "fill-outline-color": "#3f5e3b"}},
    {"id": "cemetery", "type": "fill", "source-layer": "landuse", "filter": ["==", "class", "cemetery"], "paint": {"fill-color": "#2e352b"}},
    {"id": "parking", "type": "fill", "source-layer": "landuse", "minzoom": 14, "filter": ["==", "class", "parking"], "paint": {"fill-color": "#443e35", "fill-outline-color": "#544c41"}},
    {"id": "water", "type": "fill", "source-layer": "water", "filter": ["all", ["==", "$type", "Polygon"], ["!=", "class", "swimming_pool"]], "paint": {"fill-color": "#33467a"}},
    {"id": "pool", "type": "fill", "source-layer": "water", "minzoom": 15, "filter": ["==", "class", "swimming_pool"], "paint": {"fill-color": "#3d5a8f", "fill-outline-color": "#5373a8"}},
    {"id": "waterway", "type": "line", "source-layer": "waterway", "filter": ["all", ["==", "$type", "LineString"], ["!=", "brunnel", "tunnel"]], "paint": {"line-color": "#3d5590", "line-width": {"base": 1.4, "stops": [[10, 0.4], [14, 1], [18, 3]]}}},
    {"id": "golf-rough", "type": "fill", "source-layer": "golf", "filter": ["all", ["==", "$type", "Polygon"], ["==", "class", "rough"]], "paint": {"fill-color": "#2a4029"}},
    {"id": "golf-fairway", "type": "fill", "source-layer": "golf", "filter": ["all", ["==", "$type", "Polygon"], ["in", "class", "fairway", "driving_range"]], "paint": {"fill-color": "#31512f"}},
    {"id": "golf-tee", "type": "fill", "source-layer": "golf", "filter": ["all", ["==", "$type", "Polygon"], ["==", "class", "tee"]], "paint": {"fill-color": "#3a5e35", "fill-outline-color": "#4f7847"}},
    {"id": "golf-green", "type": "fill", "source-layer": "golf", "filter": ["all", ["==", "$type", "Polygon"], ["==", "class", "green"]], "paint": {"fill-color": "#447242", "fill-outline-color": "#5c8c54"}},
    {"id": "golf-bunker", "type": "fill", "source-layer": "golf", "filter": ["all", ["==", "$type", "Polygon"], ["==", "class", "bunker"]], "paint": {"fill-color": "#5e4b2e", "fill-outline-color": "#7c6439"}},
    {"id": "golf-hazard", "type": "fill", "source-layer": "golf", "filter": ["all", ["==", "$type", "Polygon"], ["in", "class", "water_hazard", "lateral_water_hazard", "penalty_area"]], "paint": {"fill-color": "#33467a"}},
    {"id": "golf-hole", "type": "line", "source-layer": "golf", "minzoom": 15.5, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "hole"]], "paint": {"line-color": "#d0d0d0", "line-opacity": 0.5, "line-width": {"stops": [[15.5, 0.6], [19, 1.6]]}, "line-dasharray": [4, 3]}},
    {"id": "building", "type": "fill", "source-layer": "building", "minzoom": 14, "paint": {"fill-color": "#26221d", "fill-outline-color": {"stops": [[14, "#5a5a5a"], [15, "#8a8a8a"]]}}},
    {"id": "pier-area", "type": "fill", "source-layer": "transportation", "minzoom": 14, "filter": ["all", ["==", "$type", "Polygon"], ["==", "class", "pier"]], "paint": {"fill-color": "#5a4a35", "fill-outline-color": "#75603f"}},
    {"id": "pier", "type": "line", "source-layer": "transportation", "minzoom": 14, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "pier"]], "paint": {"line-color": "#7a6445", "line-width": {"stops": [[14, 1], [18, 4]]}}},
    {"id": "road-service-casing", "type": "line", "source-layer": "transportation", "minzoom": 14, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "service"], ["!in", "service", "driveway", "parking_aisle"], ["!has", "golf"]], "paint": {"line-color": "#1f1e1c", "line-width": {"base": 1.5, "stops": [[14, 1.5], [16, 3.5], [19, 10]]}}},
    {"id": "road-driveway-casing", "type": "line", "source-layer": "transportation", "minzoom": 16, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "service"], ["in", "service", "driveway", "parking_aisle"]], "paint": {"line-color": "#232220", "line-width": {"base": 1.5, "stops": [[16, 2], [19, 7]]}}},
    {"id": "road-minor-casing", "type": "line", "source-layer": "transportation", "minzoom": 12, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "minor"]], "paint": {"line-color": "#1f1e1c", "line-width": {"base": 1.5, "stops": [[12, 1], [15, 4.5], [19, 17]]}}},
    {"id": "road-major-casing", "type": "line", "source-layer": "transportation", "minzoom": 9, "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "tertiary", "secondary", "primary", "trunk"]], "paint": {"line-color": "#2a2419", "line-width": {"base": 1.5, "stops": [[9, 1.2], [13, 3.5], [16, 8], [19, 22]]}}},
    {"id": "road-service", "type": "line", "source-layer": "transportation", "minzoom": 14, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "service"], ["!in", "service", "driveway", "parking_aisle"], ["!has", "golf"]], "paint": {"line-color": "#5e574b", "line-width": {"base": 1.5, "stops": [[14, 0.6], [16, 2], [19, 7.5]]}}},
    {"id": "road-driveway", "type": "line", "source-layer": "transportation", "minzoom": 16, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "service"], ["in", "service", "driveway", "parking_aisle"]], "paint": {"line-color": "#4b453c", "line-width": {"base": 1.5, "stops": [[16, 1], [19, 5]]}}},
    {"id": "road-minor", "type": "line", "source-layer": "transportation", "minzoom": 12, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "minor"]], "paint": {"line-color": "#6b6252", "line-width": {"base": 1.5, "stops": [[12, 0.4], [15, 3], [19, 14]]}}},
    {"id": "road-major", "type": "line", "source-layer": "transportation", "minzoom": 9, "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "tertiary", "secondary", "primary", "trunk"]], "paint": {"line-color": "#94805a", "line-width": {"base": 1.5, "stops": [[9, 0.6], [13, 2.2], [16, 6], [19, 19]]}}},
    {"id": "golf-path", "type": "line", "source-layer": "transportation", "minzoom": 15, "filter": ["all", ["==", "$type", "LineString"], ["any", ["has", "golf"], ["all", ["==", "class", "path"], ["==", "subclass", "path"], ["any", ["==", "foot", "designated"], ["==", "bicycle", "no"]]], ["all", ["==", "class", "track"], ["any", ["==", "surface", "paved"], ["==", "bicycle", "no"]]]]], "paint": {"line-color": "#7a9168", "line-width": {"stops": [[15, 0.8], [19, 2.5]]}, "line-dasharray": [2, 1.5]}},
    {"id": "track", "type": "line", "source-layer": "transportation", "minzoom": 13, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "track"], ["!=", "surface", "paved"], ["!=", "bicycle", "no"]], "paint": {"line-color": "#97805a", "line-width": {"stops": [[13, 0.8], [18, 2.5]]}, "line-dasharray": [3, 2]}},
    {"id": "boardwalk-casing", "type": "line", "source-layer": "transportation", "minzoom": 14, "filter": ["all", ["==", "$type", "LineString"], ["==", "boardwalk", "yes"]], "paint": {"line-color": "#2a1d12", "line-width": {"base": 1.4, "stops": [[14, 2], [16, 4], [19, 9]]}}},
    {"id": "boardwalk", "type": "line", "source-layer": "transportation", "minzoom": 14, "filter": ["all", ["==", "$type", "LineString"], ["==", "boardwalk", "yes"]], "paint": {"line-color": "#a07d4f", "line-width": {"base": 1.4, "stops": [[14, 1], [16, 2.4], [19, 6]]}}},
    {"_comment": "Walking: footways, steps and public paths that do not admit bicycles and are not golf paths.", "id": "walk", "type": "line", "source-layer": "transportation", "minzoom": 13, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "path"], ["!in", "subclass", "cycleway"], ["!in", "bicycle", "yes", "designated", "permissive"], ["!has", "golf"], ["!=", "boardwalk", "yes"], ["none", ["all", ["==", "subclass", "path"], ["any", ["==", "foot", "designated"], ["==", "bicycle", "no"]]]]], "paint": {"line-color": "#c98b64", "line-width": {"base": 1.3, "stops": [[13, 0.8], [16, 1.8], [19, 4]]}, "line-dasharray": [2.5, 1.5]}},
    {"_comment": "Cycling: highway=cycleway, and any path that admits bicycles. A red casing around a pale fill; below z14 the casing alone.", "id": "bike-casing", "type": "line", "source-layer": "transportation", "minzoom": 11, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "path"], ["!has", "golf"], ["any", ["==", "subclass", "cycleway"], ["in", "bicycle", "yes", "designated", "permissive"]]], "paint": {"line-color": "#e2563d", "line-width": {"base": 1.4, "stops": [[11, 0.7], [14, 2.4], [16, 3.8], [19, 7.5]]}}},
    {"id": "bike-bridge-casing", "type": "line", "source-layer": "transportation", "minzoom": 14, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "path"], ["==", "brunnel", "bridge"], ["!=", "boardwalk", "yes"], ["any", ["==", "subclass", "cycleway"], ["in", "bicycle", "yes", "designated", "permissive"]]], "paint": {"line-color": "#7a7066", "line-width": {"base": 1.4, "stops": [[14, 3.6], [16, 5.2], [19, 9.5]]}}},
    {"id": "bike", "type": "line", "source-layer": "transportation", "minzoom": 13.5, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "path"], ["!has", "golf"], ["any", ["==", "subclass", "cycleway"], ["in", "bicycle", "yes", "designated", "permissive"]]], "paint": {"line-color": "#f2b6a6", "line-width": {"base": 1.4, "stops": [[13.5, 0.3], [14, 0.9], [16, 1.8], [19, 4]]}}},
    {"id": "gate", "type": "circle", "source-layer": "poi", "minzoom": 15.5, "filter": ["all", ["==", "$type", "Point"], ["==", "class", "barrier"]], "paint": {"circle-color": "#bdb2a4", "circle-radius": {"stops": [[15.5, 2], [19, 4.5]]}}},
    {"id": "crossing-ring", "type": "circle", "source-layer": "poi", "minzoom": 16, "filter": ["all", ["==", "$type", "Point"], ["==", "class", "crossing"]], "paint": {"circle-color": "#c9bfb2", "circle-radius": {"stops": [[16, 3], [19, 5.5]]}}},
    {"id": "crossing-core", "type": "circle", "source-layer": "poi", "minzoom": 16, "filter": ["all", ["==", "$type", "Point"], ["==", "class", "crossing"]], "paint": {"circle-color": "#30342c", "circle-radius": {"stops": [[16, 1.6], [19, 3.2]]}}},
    {"id": "golf-hole-marker", "type": "circle", "source-layer": "golf", "minzoom": 15, "filter": ["all", ["==", "$type", "Point"], ["==", "class", "hole"]], "paint": {"circle-color": "#3f8a44", "circle-opacity": 0.9, "circle-radius": {"stops": [[15, 5.5], [17, 8], [19, 10]]}}},
    {"id": "golf-hole-number", "type": "symbol", "source-layer": "golf", "minzoom": 15, "filter": ["all", ["==", "$type", "Point"], ["==", "class", "hole"]], "layout": {"text-field": "{ref}", "text-size": {"stops": [[15, 8], [17, 10.5], [19, 13]]}, "text-offset": [0, -0.21]}, "paint": {"text-color": "#ffffff"}},
    {"id": "water-name", "type": "symbol", "source-layer": "water_name", "minzoom": 15, "filter": ["==", "$type", "Point"], "layout": {"text-field": "{name:latin}", "text-size": 10.5}, "paint": {"text-color": "#93b3e6", "text-halo-color": "#1d2744", "text-halo-width": 1.2}},
    {"id": "river-name", "type": "symbol", "source-layer": "water_name", "minzoom": 14, "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "river", "canal"]], "layout": {"text-field": "{name:latin}", "symbol-placement": "line", "symbol-spacing": 400, "text-size": {"stops": [[14, 10], [18, 13]]}}, "paint": {"text-color": "#93b3e6", "text-halo-color": "#1d2744", "text-halo-width": 1.2}},
    {"id": "boardwalk-name", "type": "symbol", "source-layer": "transportation_name", "minzoom": 15, "filter": ["all", ["==", "$type", "LineString"], ["==", "boardwalk", "yes"]], "layout": {"text-field": "{name:latin}", "symbol-placement": "point", "text-anchor": "left", "text-offset": [0.6, 0], "text-size": {"stops": [[15, 9.5], [18, 12]]}}, "paint": {"text-color": "#dcbc8c", "text-halo-color": "#2e2418", "text-halo-width": 1.6}},
    {"id": "path-name", "type": "symbol", "source-layer": "transportation_name", "minzoom": 16.5, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "path"], ["!=", "boardwalk", "yes"]], "layout": {"text-field": "{name:latin}", "symbol-placement": "line", "symbol-spacing": 300, "text-offset": [0, 0.9], "text-size": {"stops": [[16.5, 9.5], [19, 12]]}}, "paint": {"text-color": "#dba584", "text-halo-color": "#2e2418", "text-halo-width": 1.5}},
    {"id": "road-name-minor", "type": "symbol", "source-layer": "transportation_name", "minzoom": 15.5, "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "minor", "service"]], "layout": {"text-field": "{name:latin}", "symbol-placement": "line", "symbol-spacing": 350, "text-size": {"stops": [[15.5, 9.5], [19, 13]]}}, "paint": {"text-color": "#f1ede6", "text-halo-color": "#4d3e2e", "text-halo-width": 1.5}},
    {"id": "road-name-major", "type": "symbol", "source-layer": "transportation_name", "minzoom": 13.5, "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "tertiary", "secondary", "primary", "trunk"]], "layout": {"text-field": "{name:latin}", "symbol-placement": "line", "symbol-spacing": 450, "text-size": {"stops": [[13.5, 10], [16, 11.5], [19, 15]]}}, "paint": {"text-color": "#f8f5ef", "text-halo-color": "#3d2e1e", "text-halo-width": 1.8}},
    {"id": "poi-food", "type": "symbol", "source-layer": "poi", "minzoom": 15.5, "filter": ["all", ["==", "$type", "Point"], ["in", "class", "restaurant", "cafe", "bar", "fast_food", "ice_cream"]], "layout": {"icon-image": "{class}_11", "text-field": "{name:latin}", "text-size": 10, "text-anchor": "top", "text-offset": [0, 0.9]}, "paint": {"text-color": "#f0a46a", "text-halo-color": "#2e2418", "text-halo-width": 1.3}},
    {"id": "poi-places", "type": "symbol", "source-layer": "poi", "minzoom": 15.5, "filter": ["all", ["==", "$type", "Point"], ["in", "class", "lodging", "grocery", "harbor", "attraction", "information", "campsite", "zoo"]], "layout": {"icon-image": "{class}_11", "text-field": "{name:latin}", "text-size": 10, "text-anchor": "top", "text-offset": [0, 0.9]}, "paint": {"text-color": "#cbbfb0", "text-halo-color": "#2e2418", "text-halo-width": 1.3}},
    {"id": "poi-parking", "type": "symbol", "source-layer": "poi", "minzoom": 16, "filter": ["all", ["==", "$type", "Point"], ["==", "subclass", "parking"]], "layout": {"icon-image": "parking_11"}},
    {"id": "poi-playground", "type": "symbol", "source-layer": "poi", "minzoom": 16.5, "filter": ["all", ["==", "$type", "Point"], ["==", "subclass", "playground"]], "layout": {"icon-image": "playground_11"}},
    {"id": "poi-tennis", "type": "symbol", "source-layer": "poi", "minzoom": 17.5, "filter": ["all", ["==", "$type", "Point"], ["==", "subclass", "tennis"]], "layout": {"icon-image": "tennis_11"}},
    {"id": "poi-worship", "type": "symbol", "source-layer": "poi", "minzoom": 16, "filter": ["all", ["==", "$type", "Point"], ["==", "class", "place_of_worship"]], "layout": {"icon-image": "place_of_worship_11"}},
    {"id": "tower", "type": "symbol", "source-layer": "man_made", "minzoom": 16, "filter": ["all", ["==", "$type", "Point"], ["in", "class", "tower", "water_tower"]], "layout": {"icon-image": "viewpoint_11"}},
    {"id": "place-neighbourhood", "type": "symbol", "source-layer": "place", "minzoom": 15, "maxzoom": 17.5, "filter": ["all", ["==", "$type", "Point"], ["in", "class", "neighbourhood", "quarter", "hamlet"]], "layout": {"text-field": "{name:latin}", "text-size": {"stops": [[15, 10.5], [17, 12]]}}, "paint": {"text-color": "#ab9b82", "text-halo-color": "#2e2418", "text-halo-width": 1.6}},
    {"_comment": "Course names are the strongest label from z12.5, ahead of every place name but the island's.", "id": "golf-course-name", "type": "symbol", "source-layer": "poi", "minzoom": 12.5, "filter": ["all", ["==", "$type", "Point"], ["==", "class", "golf"], ["==", "subclass", "golf_course"]], "layout": {"text-field": "{name:latin}", "text-size": {"stops": [[12.5, 10.5], [15, 12.5], [18, 14]]}, "icon-image": "golf_11", "text-anchor": "top", "text-offset": [0, 0.8]}, "paint": {"text-color": "#92d48c", "text-halo-color": "#2e2418", "text-halo-width": 1.8}},
    {"id": "place-town", "type": "symbol", "source-layer": "place", "minzoom": 9, "maxzoom": 14.5, "filter": ["all", ["==", "$type", "Point"], ["in", "class", "town", "village"]], "layout": {"text-field": "{name:latin}", "text-size": {"stops": [[9, 11], [13, 14]]}}, "paint": {"text-color": "#e3d7c3", "text-halo-color": "#2e2418", "text-halo-width": 1.8}},
    {"id": "place-island", "type": "symbol", "source-layer": "place", "minzoom": 9, "maxzoom": 14, "filter": ["all", ["==", "$type", "Point"], ["==", "class", "island"]], "layout": {"text-field": "{name:latin}", "text-size": {"stops": [[9, 11], [13, 16]]}}, "paint": {"text-color": "#d6c7aa", "text-halo-color": "#2e2418", "text-halo-width": 2}}
