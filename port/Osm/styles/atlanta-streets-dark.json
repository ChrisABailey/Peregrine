    {"id": "road-avoid", "type": "line", "source-layer": "transportation", "minzoom": 12, "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "primary", "trunk"]], "paint": {"line-color": "#7a4844", "line-width": {"base": 1.5, "stops": [[12, 1], [13, 2.6], [16, 7.5], [19, 20]]}}},
    {"id": "road-interstate", "type": "line", "source-layer": "transportation", "minzoom": 8.5, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "motorway"]], "paint": {"line-color": "#7a4844", "line-width": {"base": 1.5, "stops": [[8.5, 0.8], [10, 1.8], [13, 4], [16, 10], [19, 26]]}}},
    {"_comment": "Bridges a rider can use: a dark edge, then the road redrawn in its tier colours, so the crossings over interstates and rail stand out. Interstate overpasses are left plain. Widths follow each class's casing.", "id": "bridge-edge", "type": "line", "source-layer": "transportation", "minzoom": 13, "filter": ["all", ["==", "$type", "LineString"], ["==", "brunnel", "bridge"], ["any", ["in", "class", "trunk", "primary", "secondary", "tertiary", "minor", "service"], ["all", ["in", "class", "path", "track"], ["any", ["==", "subclass", "cycleway"], ["in", "bicycle", "yes", "designated", "permissive"]]]]], "paint": {"line-color": "#8c877e", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 13, ["match", ["get", "class"], "motorway", 8, ["primary", "trunk"], 6, "secondary", 5.5, "tertiary", 5, "minor", 3.5, "service", 2, 4], 16, ["match", ["get", "class"], "motorway", 15, ["primary", "trunk"], 12, "secondary", 11, "tertiary", 10, "minor", 7.5, "service", 5, 6.5], 19, ["match", ["get", "class"], "motorway", 32, ["primary", "trunk"], 26, "secondary", 24, "tertiary", 22, "minor", 18, "service", 11, 11]]}},
    {"id": "bridge-casing", "type": "line", "source-layer": "transportation", "minzoom": 13, "filter": ["all", ["==", "$type", "LineString"], ["==", "brunnel", "bridge"], ["in", "class", "trunk", "primary", "secondary", "tertiary", "minor", "service"]], "paint": {"line-color": ["case", ["==", ["get", "bicycle"], "designated"], "#3fb56a", ["==", ["get", "bicycle"], "no"], "#8a8592", ["match", ["get", "class"], "motorway", "#8378c9", ["primary", "trunk"], "#ef5b52", "secondary", "#f39545", "tertiary", "#d9b03a", "minor", "#5e8a69", "service", "#4d6b55", "#2cc4c9"]], "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 13, ["match", ["get", "class"], "motorway", 6, ["primary", "trunk"], 4, "secondary", 3.5, "tertiary", 3, "minor", 1.5, "service", 1, 2], 16, ["match", ["get", "class"], "motorway", 13, ["primary", "trunk"], 10, "secondary", 9, "tertiary", 8, "minor", 5.5, "service", 3, 4.5], 19, ["match", ["get", "class"], "motorway", 30, ["primary", "trunk"], 24, "secondary", 22, "tertiary", 20, "minor", 16, "service", 9, 9]]}},
    {"id": "bridge", "type": "line", "source-layer": "transportation", "minzoom": 13.5, "filter": ["all", ["==", "$type", "LineString"], ["==", "brunnel", "bridge"], ["in", "class", "trunk", "primary", "secondary", "tertiary", "minor", "service"]], "paint": {"line-color": ["match", ["get", "class"], "motorway", "#7a4844", ["primary", "trunk"], "#7a4844", "secondary", "#6e5a44", "tertiary", "#5f5a4a", ["path", "track"], "#173a3d", "#5c5a55"], "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 13, ["match", ["get", "class"], "motorway", 4, ["primary", "trunk"], 2.6, "secondary", 2.2, "tertiary", 1.8, "minor", 0.9, "service", 0.3, 0], 16, ["match", ["get", "class"], "motorway", 10, ["primary", "trunk"], 7.5, "secondary", 6.5, "tertiary", 5.5, "minor", 3.8, "service", 1.8, 0], 19, ["match", ["get", "class"], "motorway", 26, ["primary", "trunk"], 20, "secondary", 18, "tertiary", 16, "minor", 13, "service", 7, 0]]}},
    {"_comment": "Tunnels are washed toward the ground colour: the road is there, but not where a rider can join it.", "id": "tunnel-wash", "type": "line", "source-layer": "transportation", "minzoom": 12, "filter": ["all", ["==", "$type", "LineString"], ["==", "brunnel", "tunnel"], ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"]], "paint": {"line-color": "#2b2d30", "line-opacity": 0.65, "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 13, ["match", ["get", "class"], "motorway", 8, ["primary", "trunk"], 6, "secondary", 5.5, "tertiary", 5, "minor", 3.5, "service", 2, 4], 16, ["match", ["get", "class"], "motorway", 15, ["primary", "trunk"], 12, "secondary", 11, "tertiary", 10, "minor", 7.5, "service", 5, 6.5], 19, ["match", ["get", "class"], "motorway", 32, ["primary", "trunk"], 26, "secondary", 24, "tertiary", 22, "minor", 18, "service", 11, 11]]}},
    {"_comment": "On-road provision from the profile's `cycleway` (the strongest of cycleway, :both, :right, :left): a protected track solid, a painted or bus-shared lane dashed, a shared-lane marking dotted. A side mapped as its own way is drawn as a trail instead.", "id": "bike-track", "type": "line", "source-layer": "transportation", "minzoom": 13, "filter": ["all", ["==", "$type", "LineString"], ["==", "cycleway", "track"]], "paint": {"line-color": "#2cc4c9", "line-width": {"base": 1.4, "stops": [[13, 1.2], [16, 2.8], [19, 5]]}}},
    {"id": "bike-lane", "type": "line", "source-layer": "transportation", "minzoom": 13, "filter": ["all", ["==", "$type", "LineString"], ["in", "cycleway", "lane", "share_busway"]], "paint": {"line-color": "#3fb56a", "line-width": {"base": 1.4, "stops": [[13, 0.8], [16, 2], [19, 4]]}, "line-dasharray": [3, 1.5]}},
    {"id": "bike-route", "type": "line", "source-layer": "bike_route", "minzoom": 12, "paint": {"line-color": ["match", ["get", "network"], "national", "#7fe0a4", "regional", "#3fb56a", "#2e7d4f"], "line-width": {"base": 1.2, "stops": [[12, 1], [14, 1.8], [17, 4.5]]}}},
    {"id": "bike-shared", "type": "line", "source-layer": "transportation", "minzoom": 15, "filter": ["all", ["==", "$type", "LineString"], ["==", "cycleway", "shared_lane"]], "paint": {"line-color": "#3fb56a", "line-width": {"stops": [[15, 1], [19, 2.5]]}, "line-dasharray": [0.5, 2]}},
    {"id": "track", "type": "line", "source-layer": "transportation", "minzoom": 13, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "track"], ["!in", "bicycle", "yes", "designated", "permissive"]], "paint": {"line-color": "#97805a", "line-width": {"stops": [[13, 0.8], [18, 2.5]]}, "line-dasharray": [3, 2]}},
    {"_comment": "Sidewalks and crossings are class=path subclass=footway. They cannot be ridden here, so they wait until the map is close enough to show a block's edge.", "id": "sidewalk", "type": "line", "source-layer": "transportation", "minzoom": 16.5, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "path"], ["in", "subclass", "footway", "pedestrian"], ["!in", "bicycle", "yes", "designated", "permissive"], ["!has", "golf"]], "paint": {"line-color": "#7a7067", "line-width": {"stops": [[16.5, 0.6], [19, 1.8]]}, "line-dasharray": [2, 1.5]}},
    {"id": "steps", "type": "line", "source-layer": "transportation", "minzoom": 15, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "path"], ["==", "subclass", "steps"]], "paint": {"line-color": "#c47a5e", "line-width": {"stops": [[15, 1.5], [19, 5]]}, "line-dasharray": [0.4, 0.4]}},
    {"_comment": "Walking trails: generic paths and bridleways that do not admit bicycles. Unlike sidewalks they run through parks and are worth seeing from z14.", "id": "walk", "type": "line", "source-layer": "transportation", "minzoom": 14, "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "path"], ["in", "subclass", "path", "bridleway"], ["!in", "bicycle", "yes", "designated", "permissive"], ["!has", "golf"]], "paint": {"line-color": "#c98b64", "line-width": {"base": 1.3, "stops": [[14, 0.8], [16, 1.6], [19, 3.5]]}, "line-dasharray": [2.5, 1.5]}},
