{
  "version": 8,
  "name": "Peregrine OSM (OpenMapTiles)",
  "metadata": {
    "peregrine:note": "Written for OSM phase O2 against the OpenMapTiles schema, which is what the delivered us-south.mbtiles was cut to ('Tilemaker to OpenMapTiles schema'). It stays inside the subset fv::OsmStyleEngine declares: legacy filters, constants and {base, stops} zoom functions, no sprites and no glyph URLs. The road layers are deliberately built as casing/fill PAIRS - a wide dark line at a low index and a narrow bright one above it - because that is the construction that makes style-layer draw order matter, and it is what the engine's priority = layer index exists to reproduce.",
    "peregrine:follow-up": "Vendoring openmaptiles/osm-bright-gl-style (BSD-3/CC-BY) as a second, third-party reference style is still open; it needs a network fetch and a NOTICE.md entry."
  },
  "sources": {
    "openmaptiles": { "type": "vector" }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f8f4f0" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": { "fill-color": "#d8e8c8", "fill-opacity": 0.7 }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source-layer": "landcover",
      "filter": ["in", "class", "grass", "farmland"],
      "paint": { "fill-color": "#e6f0d8" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "minzoom": 8,
      "paint": { "fill-color": "#e0dfdf", "fill-opacity": 0.5 }
    },
    {
      "id": "park",
      "type": "fill",
      "source-layer": "park",
      "paint": { "fill-color": "#d8e8c8", "fill-opacity": 0.6 }
    },
    {
      "id": "water",
      "type": "fill",
      "source-layer": "water",
      "filter": ["!=", "brunnel", "tunnel"],
      "paint": { "fill-color": "#a0c8f0" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source-layer": "waterway",
      "minzoom": 8,
      "paint": {
        "line-color": "#a0c8f0",
        "line-width": { "base": 1.3, "stops": [[8, 0.5], [14, 2.0], [18, 6.0]] }
      }
    },
    {
      "id": "aeroway-runway",
      "type": "line",
      "source-layer": "aeroway",
      "filter": ["==", "class", "runway"],
      "minzoom": 10,
      "paint": {
        "line-color": "#c8c8cc",
        "line-width": { "base": 1.5, "stops": [[10, 2.0], [16, 14.0]] }
      }
    },

    {
      "id": "road-minor-casing",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "minor", "service", "track"], ["!=", "brunnel", "tunnel"]],
      "minzoom": 12,
      "paint": {
        "line-color": "#cfcdca",
        "line-width": { "base": 1.4, "stops": [[12, 1.5], [16, 6.0], [20, 24.0]] }
      }
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "secondary", "tertiary"], ["!=", "brunnel", "tunnel"]],
      "minzoom": 9,
      "paint": {
        "line-color": "#c0b8a8",
        "line-width": { "base": 1.4, "stops": [[9, 1.5], [14, 6.0], [20, 34.0]] }
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "primary", "trunk"], ["!=", "brunnel", "tunnel"]],
      "minzoom": 6,
      "paint": {
        "line-color": "#a06b3c",
        "line-width": { "base": 1.4, "stops": [[6, 1.0], [14, 8.0], [20, 40.0]] }
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "motorway"], ["!=", "brunnel", "tunnel"]],
      "minzoom": 4,
      "paint": {
        "line-color": "#8a4b2a",
        "line-width": { "base": 1.4, "stops": [[4, 1.0], [14, 10.0], [20, 46.0]] }
      }
    },

    {
      "id": "road-minor",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "minor", "service", "track"], ["!=", "brunnel", "tunnel"]],
      "minzoom": 12,
      "paint": {
        "line-color": "#ffffff",
        "line-width": { "base": 1.4, "stops": [[12, 0.5], [16, 4.0], [20, 20.0]] }
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "secondary", "tertiary"], ["!=", "brunnel", "tunnel"]],
      "minzoom": 9,
      "paint": {
        "line-color": "#fefefe",
        "line-width": { "base": 1.4, "stops": [[9, 0.5], [14, 4.0], [20, 30.0]] }
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "primary", "trunk"], ["!=", "brunnel", "tunnel"]],
      "minzoom": 6,
      "paint": {
        "line-color": "#fea",
        "line-width": { "base": 1.4, "stops": [[6, 0.5], [14, 6.0], [20, 36.0]] }
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "motorway"], ["!=", "brunnel", "tunnel"]],
      "minzoom": 4,
      "paint": {
        "line-color": "#fc8",
        "line-width": { "base": 1.4, "stops": [[4, 0.5], [14, 8.0], [20, 42.0]] }
      }
    },
    {
      "id": "road-rail",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "minzoom": 10,
      "paint": {
        "line-color": "#a8a8a8",
        "line-width": { "base": 1.4, "stops": [[10, 0.8], [16, 2.5]] },
        "line-dasharray": [3, 3]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["==", "class", "path"],
      "minzoom": 14,
      "paint": {
        "line-color": "#b0a08c",
        "line-width": { "stops": [[14, 0.8], [18, 2.0]] },
        "line-dasharray": [2, 2]
      }
    },

    {
      "id": "building",
      "type": "fill",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d9d0c9",
        "fill-outline-color": "#c6bcb2"
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source-layer": "boundary",
      "filter": ["<=", "admin_level", "2"],
      "paint": {
        "line-color": "#9e9cab",
        "line-width": { "base": 1.2, "stops": [[3, 0.8], [10, 2.5]] },
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source-layer": "boundary",
      "filter": ["all", [">", "admin_level", "2"], ["<=", "admin_level", "4"]],
      "minzoom": 4,
      "paint": {
        "line-color": "#b0aebb",
        "line-width": { "base": 1.2, "stops": [[4, 0.6], [12, 1.8]] },
        "line-dasharray": [3, 2]
      }
    },

    {
      "id": "poi-dot",
      "type": "circle",
      "source-layer": "poi",
      "minzoom": 15,
      "paint": {
        "circle-color": "#8b6f52",
        "circle-radius": { "stops": [[15, 2.0], [18, 4.0]] }
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source-layer": "water_name",
      "minzoom": 9,
      "layout": {
        "text-field": "{name:latin}",
        "text-size": { "stops": [[9, 10.0], [14, 13.0]] }
      },
      "paint": { "text-color": "#3f7ea8",
                 "text-halo-color": "#eef4f8", "text-halo-width": 1.5 }
    },
    {
      "id": "road-name",
      "type": "symbol",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "text-field": "{name:latin}",
        "text-size": { "stops": [[14, 10.0], [18, 13.0]] },
        "symbol-placement": "line",
        "symbol-spacing": 400,
        "text-max-angle": 40,
        "text-offset": [0, -0.7]
      },
      "paint": { "text-color": "#5a5a5a",
                 "text-halo-color": "#ffffff", "text-halo-width": 1.5 }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source-layer": "place",
      "filter": ["in", "class", "town", "village", "suburb"],
      "minzoom": 9,
      "layout": {
        "text-field": "{name:latin}",
        "text-size": { "stops": [[9, 10.0], [14, 15.0]] }
      },
      "paint": { "text-color": "#4a4a4a",
                 "text-halo-color": "#ffffff", "text-halo-width": 1.5 }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source-layer": "place",
      "filter": ["==", "class", "city"],
      "minzoom": 4,
      "layout": {
        "text-field": "{name:latin}",
        "text-size": { "base": 1.2, "stops": [[4, 11.0], [12, 20.0]] }
      },
      "paint": { "text-color": "#333333",
                 "text-halo-color": "#ffffff", "text-halo-width": 2 }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source-layer": "place",
      "filter": ["==", "class", "state"],
      "minzoom": 3,
      "maxzoom": 8,
      "layout": {
        "text-field": "{name:latin}",
        "text-size": { "stops": [[3, 10.0], [7, 14.0]] }
      },
      "paint": { "text-color": "#7a7a7a",
                 "text-halo-color": "#ffffff", "text-halo-width": 2 }
    }
  ]
}
